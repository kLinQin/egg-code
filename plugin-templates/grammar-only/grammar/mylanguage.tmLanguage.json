{
  "name": "MyLanguage",
  "scopeName": "source.mylanguage",
  "patterns": [
    {
      "match": "\\b(if|else|while|for|return)\\b",
      "name": "keyword.control.mylanguage"
    },
    {
      "match": "//.*$",
      "name": "comment.line.double-slash.mylanguage"
    },
    {
      "match": "\"[^\"]*\"",
      "name": "string.quoted.double.mylanguage"
    }
  ]
}