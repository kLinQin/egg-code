<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Egg" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.Egg.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:statusBarColor">@color/window_background_light</item>
        <item name="android:navigationBarColor">@color/window_background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Egg.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
        <item name="android:statusBarColor">@color/window_background_dark</item>
        <item name="android:navigationBarColor">@color/window_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>